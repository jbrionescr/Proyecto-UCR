# =============================================================================
# Plantilla de variables de entorno del Frontend (Next.js 14).
#
# Copiar como `Frontend/.env.local` y rellenar con credenciales propias.
#
# IMPORTANTE sobre el prefijo NEXT_PUBLIC_:
# Next.js incrusta en el bundle del navegador toda variable que lo lleve. Por
# eso solo deben marcarse asi los valores que pueden ser publicos (URLs, claves
# anonimas, identificadores). Cualquier secreto real va SIN el prefijo, de modo
# que quede unicamente del lado del servidor.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Clave de servicio: ignora las politicas de acceso (RLS). Sin prefijo publico
# a proposito, para que nunca se envie al navegador.
SUPABASE_SERVICE_KEY=tu_service_role_key

# -----------------------------------------------------------------------------
# Base de datos (Prisma)
# -----------------------------------------------------------------------------
# Ver la nota sobre el pooler y el prefijo `aws-N` en backend/.env.example.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-N-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=genera_una_clave_aleatoria_larga
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# API del backend Express
# -----------------------------------------------------------------------------
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Inteligencia artificial (asistente de curriculum y de proyecto)
# -----------------------------------------------------------------------------
GROQ_API_KEY=tu_api_key_de_groq

# -----------------------------------------------------------------------------
# Cloudinary (imagenes de perfil y adjuntos)
# -----------------------------------------------------------------------------
# El upload preset debe ser de tipo "unsigned" para permitir la subida desde el
# navegador sin exponer el API secret de Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

# -----------------------------------------------------------------------------
# Correo transaccional
# -----------------------------------------------------------------------------
RESEND_API_KEY=tu_api_key_de_resend
RESEND_FROM_EMAIL=no-reply@tu-dominio.com

EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_AUTH_TEMPLATE_ID=
EMAILJS_NOTIFICATION_TEMPLATE_ID=
EMAILJS_DONACION_ATRASADA_TEMPLATE=

# Plantillas del flujo de postulaciones a posiciones.
EMAILJS_APPLICANT_SERVICE_ID=
EMAILJS_APPLICANT_PUBLIC_KEY=
EMAILJS_APPLICANT_PRIVATE_KEY=
EMAILJS_APPLICANT_ACCEPTED_TEMPLATE=
EMAILJS_APPLICANT_REJECTED_TEMPLATE=

# -----------------------------------------------------------------------------
# Automatizaciones (n8n)
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Tareas programadas
# -----------------------------------------------------------------------------
# Secreto compartido que autentica las invocaciones a las rutas de cron y evita
# que cualquiera pueda dispararlas desde fuera.
CRON_SECRET=genera_una_clave_aleatoria

# -----------------------------------------------------------------------------
# Reglas de negocio
# -----------------------------------------------------------------------------
# Si es "true", el registro de estudiantes exige correo institucional @ucr.ac.cr.
# Conviene ponerlo en "false" en desarrollo para poder probar con otros correos.
NEXT_PUBLIC_REQUIRE_UCR_EMAIL_DOMAIN=true

ADMIN_EMAIL=admin@tu-dominio.com
NODE_ENV=development
