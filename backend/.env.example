# =============================================================================
# Plantilla de variables de entorno del Backend (Express).
#
# Copiar como `backend/.env` y rellenar con credenciales propias.
# El archivo `.env` esta excluido del control de versiones: nunca debe subirse.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL en Supabase)
# -----------------------------------------------------------------------------
# Usar la cadena del pooler, no la del host directo: en el plan gratuito
# `db.<ref>.supabase.co` solo resuelve por IPv6 y falla en redes IPv4.
#
# El prefijo `aws-N` varia por proyecto (aws-0, aws-1, aws-2...). Copiar el host
# exacto desde el boton "Connect" del panel de Supabase; el de la documentacion
# oficial siempre muestra aws-0 y rara vez coincide.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-N-<region>.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=tu_anon_key

# Clave de servicio: ignora las politicas de acceso (RLS) de la base de datos.
# Solo puede vivir en el servidor; jamas debe llegar al navegador.
SUPABASE_SERVICE_KEY=tu_service_role_key

# -----------------------------------------------------------------------------
# Correo transaccional (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=tu_api_key_de_resend
FROM_EMAIL=no-reply@tu-dominio.com
EMAIL_FROM=no-reply@tu-dominio.com
TEMPLATE_ALUMNI_APPROVED=id_del_template_de_aprobacion

# -----------------------------------------------------------------------------
# Correo SMTP (alternativa a Resend)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contrasena_de_aplicacion

# -----------------------------------------------------------------------------
# EmailJS (notificaciones de restablecimiento y de mentoria)
# -----------------------------------------------------------------------------
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_PASSWORD_RESET_TEMPLATE=

MENTOR_EMAILJS_SERVICE_ID=
MENTOR_EMAILJS_PUBLIC_KEY=
MENTOR_EMAILJS_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Correo de la cuenta administradora inicial de la Fundacion.
ADMIN_EMAIL=admin@tu-dominio.com
